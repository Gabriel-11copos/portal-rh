# Banco de dados Neon Postgres (pegue em neon.tech > sua base > Connection string)
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nome_banco?sslmode=require"

# Senha única para o RH/DP acessar o painel (invente uma forte)
SENHA_RH="troque-esta-senha"

# Chave secreta para os tokens de login (pode ser qualquer texto longo aleatório)
JWT_SECRET="troque-por-um-texto-aleatorio-bem-grande"

# Resend (e-mail) — crie conta gratuita em resend.com e gere uma API key
RESEND_API_KEY="re_xxxxxxxxxx"
EMAIL_REMETENTE="Portal RH <onboarding@resend.dev>"

# Google Drive — Service Account (veja o passo a passo no README)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ... cole aqui o JSON inteiro em uma linha}'
GOOGLE_DRIVE_FOLDER_ID="id_da_pasta_do_drive"
